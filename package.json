{
  "name": "secreto",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node --env-file-if-exists=.env server.js",
    "dev": "SECRETO_DEMO=1 node server.js",
    "test": "node --test tests/*.test.js",
    "test:e2e": "playwright test",
    "build": "node scripts/build.js",
    "verify:deployment": "node scripts/verify-deployment.js",
    "db:inspect": "node --env-file-if-exists=.env scripts/database.js inspect",
    "db:migrate": "node --env-file-if-exists=.env scripts/database.js migrate",
    "password:hash": "node scripts/hash-password.js"
  },
  "dependencies": {
    "pg": "8.16.3",
    "random-js": "2.1.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.3.14",
    "@playwright/test": "1.56.1"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
